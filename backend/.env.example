# =============================================================================
# RAG Backend — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.
# =============================================================================

# --- Supabase ---
GROQ_API_KEY=""
SUPABASE_KEY=""         # service-role key (full DB access, used server-side only)
SUPABASE_URL=""

# --- Hugging Face (legacy — no longer used; kept for reference) ---
HF_TOKEN=""

# --- Cohere reranking ---
COHERE_API_KEY=""

# --- Redis / Celery ---
REDIS_URL=""            # e.g. redis://localhost:6379/0

# =============================================================================
# Multimodal document RAG
# =============================================================================

# --- PDF hi-res extraction (tables + images) ---
# Set to "true" to enable Unstructured hi_res strategy for PDFs.
# Requires: torch, unstructured_inference, and Tesseract OCR on PATH.
# The hi_res stack is installed in the project venv but excluded from the
# baseline requirements.txt.  Leave blank or "false" for fast (text-only) mode.
PDF_HI_RES_ENABLED=""

# Tesseract OCR executable path (Windows).
# Only needed when PDF_HI_RES_ENABLED=true.
# Example: TESSERACT_CMD=D:\path\to\Tesseract-OCR\tesseract.exe
# Leave blank to rely on Tesseract being on your system PATH.
TESSERACT_CMD=""

# --- Vision model (image captions during summarisation) ---
# Set to "true" to call the Groq vision model when summarising image chunks.
# When disabled (the default), images are stored but marked "[Image not analyzed]".
VISION_SUMMARY_ENABLED=""

# Groq vision model for image captions.
# Default: qwen/qwen3.8-27b  (the only publicly available Groq vision model).
VISION_MODEL=""

# --- Summarisation pipeline ---
# Set to "false" to disable background chunk summarisation entirely.
# Default: true (summaries are generated for every ingested document).
SUMMARY_ENABLED=""

# Groq model used for text/table chunk summarisation.
# Default: openai/gpt-oss-120b
SUMMARY_MODEL=""

# Maximum number of chunks to summarise per document.
# Documents with more chunks are skipped (summary_status = "skipped").
# Default: 80
SUMMARY_MAX_CHUNKS=""

# Token budget per minute for summarisation pacing (avoids Groq 429 errors).
# Default: 6000
SUMMARY_TPM_BUDGET=""

# Minimum seconds between summarisation API calls.
# Default: 2.0
SUMMARY_MIN_INTERVAL=""

# --- Summary-based retrieval ---
# Set to "true" to include a third retrieval list from chunk summary embeddings
# in the RRF fusion.  Requires summaries to have been generated first.
# Default: false
SUMMARY_SEARCH_ENABLED=""

# --- Reranking ---
# Minimum Cohere relevance score (0.0–1.0) for a chunk to be used in the answer.
# Chunks below this threshold are dropped before LLM context construction.
# Default: 0.55
RERANK_MIN_SCORE=""

# --- Query expansion ---
# Set to "true" to add one LLM-generated alternative query to the RRF retrieval.
# Adds a separate vector-search pass; does not replace the original query.
# Default: false
QUERY_EXPANSION_ENABLED=""

# --- Embeddings ---
# Directory where the fastembed model files are cached (about 70 MB, downloaded once).
# Default: ~/.cache/rag_fastembed
EMBEDDING_CACHE_DIR=""
